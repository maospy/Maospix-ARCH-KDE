# Maospix-ARCH-KDE: vuelve a poner el nombre de la distro cuando una
# actualización del paquete filesystem reescribe /usr/lib/os-release.
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Target = usr/lib/os-release
Target = usr/share/maospix-arch-kde/os-release

[Action]
Description = Aplicando la identidad de Maospix-ARCH-KDE (os-release)...
When = PostTransaction
Exec = /usr/share/libalpm/scripts/maospix-os-release
